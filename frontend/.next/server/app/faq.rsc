17:Td77,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I place an order?","acceptedAnswer":{"@type":"Answer","text":"Simply browse our products, select the plan you want, and click 'Order Now'. This will redirect you to WhatsApp where you can complete your order."}},{"@type":"Question","name":"How long does delivery take?","acceptedAnswer":{"@type":"Answer","text":"Most products are delivered instantly within minutes after payment confirmation."}},{"@type":"Question","name":"What payment methods do you accept?","acceptedAnswer":{"@type":"Answer","text":"We accept eSewa, Khalti, bank transfer, and other local payment methods."}},{"@type":"Question","name":"Are your products genuine?","acceptedAnswer":{"@type":"Answer","text":"Yes! All our products are 100% genuine and sourced directly from authorized channels."}},{"@type":"Question","name":"What is Game Shop Nepal?","acceptedAnswer":{"@type":"Answer","text":"We are an online store providing digital game items, subscriptions, and services at affordable prices with fast delivery. Our mission is to offer a smooth and reliable buying experience."}},{"@type":"Question","name":"Do I need an account to make a purchase?","acceptedAnswer":{"@type":"Answer","text":"No. You can buy as a guest, but creating an account helps you track orders and access support faster."}},{"@type":"Question","name":"What if my item isn’t delivered?","acceptedAnswer":{"@type":"Answer","text":"If your order doesn’t arrive within the expected time, contact our support team with your order number for tracking."}},{"@type":"Question","name":"Why are your prices lower than some other sites?","acceptedAnswer":{"@type":"Answer","text":"We source and price digital products competitively while maintaining quality, fast delivery, and transparency."}},{"@type":"Question","name":"What information do I need to provide?","acceptedAnswer":{"@type":"Answer","text":"Only the required game ID, character ID, or account identifier — we never ask for your password or sensitive personal data."}},{"@type":"Question","name":"Is my data secure?","acceptedAnswer":{"@type":"Answer","text":"Yes. We use secure systems and industry-standard protection to safeguard your information."}},{"@type":"Question","name":"Can I get a refund?","acceptedAnswer":{"@type":"Answer","text":"Since most products are digital and delivered instantly, refunds are only possible for delivery failures or technical issues. Contact support with your order ID for assistance."}},{"@type":"Question","name":"What if my top-up or subscription doesn’t work?","acceptedAnswer":{"@type":"Answer","text":"Provide us with the order number and error details — we’ll investigate and resolve it promptly."}},{"@type":"Question","name":"How do I get help if I have a problem?","acceptedAnswer":{"@type":"Answer","text":"Reach out to our support team via the Contact Us page; we will assist you as soon as possible."}},{"@type":"Question","name":"What kinds of products do you sell?","acceptedAnswer":{"@type":"Answer","text":"We offer digital subscriptions, game currencies, items, and other digital services for popular games and platforms."}},{"@type":"Question","name":"Can I cancel or change my order?","acceptedAnswer":{"@type":"Answer","text":"Digital orders are processed instantly — once placed, they cannot usually be canceled or changed. Contact us quickly if you made a mistake."}}]}d:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],"$L18"]
