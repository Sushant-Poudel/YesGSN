18:["$","$L19",null,{"initialFAQs":[{"id":"faq1","question":"How do I place an order?","answer":"Simply browse our products, select the plan you want, and click 'Order Now'. This will redirect you to WhatsApp where you can complete your order.","category":"Ordering","sort_order":0},{"id":"faq2","question":"How long does delivery take?","answer":"Most products are delivered instantly within minutes after payment confirmation.","category":"Delivery","sort_order":1},{"id":"faq3","question":"What payment methods do you accept?","answer":"We accept eSewa, Khalti, bank transfer, and other local payment methods.","category":"Payments","sort_order":2},{"id":"faq4","question":"Are your products genuine?","answer":"Yes! All our products are 100% genuine and sourced directly from authorized channels.","category":"General","sort_order":3},{"id":"3d8fcd15-1e59-415e-85e2-34013881fcf8","question":"What is Game Shop Nepal?","answer":"We are an online store providing digital game items, subscriptions, and services at affordable prices with fast delivery. Our mission is to offer a smooth and reliable buying experience. \n","category":"General","sort_order":4},{"id":"992e01d1-c67e-4578-8022-fb4bfde86eda","question":"Do I need an account to make a purchase?","answer":"No. You can buy as a guest, but creating an account helps you track orders and access support faster.\n","category":"Support","sort_order":5},{"id":"490698d6-c527-4c2f-921d-aae0c5a62ce6","question":"What if my item isn’t delivered?","answer":"If your order doesn’t arrive within the expected time, contact our support team with your order number for tracking.\n","category":"Delivery","sort_order":7},{"id":"d603cda8-a4fc-48be-96ec-c27bebe8b7b4","question":"Why are your prices lower than some other sites?","answer":"We source and price digital products competitively while maintaining quality, fast delivery, and transparency. \n","category":"Ordering","sort_order":8},{"id":"e59673db-e9ea-4bba-a0f5-9d3e4e4f9ab8","question":"What information do I need to provide?","answer":"Only the required game ID, character ID, or account identifier — we never ask for your password or sensitive personal data. \n","category":"Ordering","sort_order":10},{"id":"a68149f3-8dea-4295-ae1d-5b2ada2454f8","question":"Is my data secure?","answer":"Yes. We use secure systems and industry-standard protection to safeguard your information. \n","category":"Support","sort_order":11},{"id":"200e2a01-18b2-4854-9083-f69bd9f52b3e","question":"Can I get a refund?","answer":"Since most products are digital and delivered instantly, refunds are only possible for delivery failures or technical issues. Contact support with your order ID for assistance.\n","category":"Support","sort_order":12},{"id":"55bcf5ee-7338-4ff6-bed2-f2e165fc39ab","question":"What if my top-up or subscription doesn’t work?","answer":"Provide us with the order number and error details — we’ll investigate and resolve it promptly.\n","category":"Delivery","sort_order":13},{"id":"91b3fc1b-0289-4d27-bd68-5ffc875ed7ea","question":"How do I get help if I have a problem?","answer":"Reach out to our support team via the Contact Us page; we will assist you as soon as possible. \n","category":"Support","sort_order":14},{"id":"c62f6c94-bdc0-495b-b79f-9746139bf7c5","question":"What kinds of products do you sell?","answer":"We offer digital subscriptions, game currencies, items, and other digital services for popular games and platforms. \n","category":"General","sort_order":15},{"id":"cc3570a7-3b26-4f2b-bf66-1151689e3108","question":"Can I cancel or change my order?","answer":"Digital orders are processed instantly — once placed, they cannot usually be canceled or changed. Contact us quickly if you made a mistake.\n","category":"Ordering","sort_order":16}]}]
