# Copy to `.env` in this directory and fill in every value.
# docker compose reads this file automatically.
# Never commit the real `.env` to git.

# ---- Public domain for the backend (Caddy will get an HTTPS cert for this) ----
API_DOMAIN=api.gameshopnepal.com

# ---- MongoDB (stays inside the droplet, not exposed to the internet) ----
MONGO_ROOT_USERNAME=gsnadmin
MONGO_ROOT_PASSWORD=REPLACE-WITH-LONG-RANDOM-STRING
DB_NAME=gameshopnepal

# ---- Backend auth ----
# Generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-64-CHAR-HEX
ADMIN_USERNAME=gsnadmin
ADMIN_PASSWORD=REPLACE-WITH-STRONG-PASSWORD

# ---- Google OAuth (customer login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Third-party integrations ----
TAKEAPP_API_KEY=
DISCORD_ORDER_WEBHOOK=
IMGBB_API_KEY=
OPENAI_API_KEY=

# ---- SMTP (Gmail app password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@gameshopnepal.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@gameshopnepal.com
SMTP_FROM_NAME=GameShop Nepal

# ---- Site ----
SITE_URL=https://gameshopnepal.com
DAILY_SUMMARY_EMAIL=support@gameshopnepal.com
