# Backend environment variables
# Set the same keys in DigitalOcean > App Platform > App > Settings > Environment Variables.
# Mark secrets (passwords, API keys, JSON blobs) as "Encrypted" in DO.

# ---- MongoDB (DigitalOcean Managed MongoDB) ----
# Full connection string from the DO Databases panel (Connection details > Flags > "Connection string").
# Includes the "?tls=true&authSource=admin&replicaSet=..." suffix. Keep it inside quotes.
MONGO_URL="mongodb+srv://doadmin:PASSWORD@db-mongodb-xxx.mongo.ondigitalocean.com/gameshopnepal?tls=true&authSource=admin&replicaSet=db-mongodb-xxx"
DB_NAME="gameshopnepal"

# ---- Auth ----
JWT_SECRET="generate-64-char-random-hex"
ADMIN_USERNAME="gsnadmin"
ADMIN_PASSWORD="change-me"

# ---- Google OAuth (customer login) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Third-party integrations ----
TAKEAPP_API_KEY=""
DISCORD_ORDER_WEBHOOK=""
IMGBB_API_KEY=""
OPENAI_API_KEY=""

# ---- SMTP (email notifications) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="GameShop Nepal"

# ---- Site ----
SITE_URL="https://gameshopnepal.com"
DAILY_SUMMARY_EMAIL=""

# ---- Google Sheets export (optional) ----
GOOGLE_SHEETS_SPREADSHEET_ID=""
# Full service-account JSON on a single line
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ---- Google Drive uploads (optional) ----
GOOGLE_DRIVE_FOLDER_ID=""
